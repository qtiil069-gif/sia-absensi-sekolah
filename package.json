{
  "name": "sia-absensi-sekolah",
  "version": "0.1.0",
  "private": true,
  "description": "Fondasi Sistem Informasi Absensi Sekolah — Google Apps Script dan Sheets",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "npm run build && npm test && npm run test:ui",
    "clasp": "clasp",
    "clasp:status": "clasp status",
    "clasp:push": "npm run build && clasp push"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.64.1",
    "@zxing/browser": "0.2.1",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.3.12",
    "qrcode": "1.5.4"
  }
}
